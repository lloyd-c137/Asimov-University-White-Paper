@import "tailwindcss";

@theme {
  --font-display: "Cinzel", serif;
  --font-serif: "Playfair Display", serif;
  --font-body: "Cormorant Garamond", serif;
  --font-chinese: "Noto Serif SC", serif;
  
  --color-au-accent: #2563eb;
  --color-au-accent-light: #dbeafe;
  --color-au-blue: #003366;
  --color-au-blue-dark: #001f3f;
  --color-au-cream: #ffffff;
  --color-au-stone: #f8fafc;
}

:root {
  background-color: var(--color-au-cream);
  color: var(--color-au-blue-dark);
}

body {
  font-family: var(--font-body);
  font-size: 1.125rem;
  line-height: 1.6;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-serif);
}

.font-chinese {
  font-family: var(--font-chinese);
}

.font-display {
  font-family: var(--font-display);
}

.glass-panel {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(37, 99, 235, 0.2);
}

.accent-gradient-text {
  background: linear-gradient(135deg, #001f3f 0%, #2563eb 50%, #60a5fa 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--color-au-blue-dark);
}

::-webkit-scrollbar-thumb {
  background: var(--color-au-accent);
  border-radius: 0px;
}

::-webkit-scrollbar-thumb:hover {
  background: #1e40af;
}

.scrollbar-thin {
  scrollbar-width: thin;
  scrollbar-color: rgba(37, 99, 235, 0.4) transparent;
}

.scrollbar-thin::-webkit-scrollbar {
  width: 6px;
}

.scrollbar-thin::-webkit-scrollbar-track {
  background: transparent;
  border-radius: 3px;
}

.scrollbar-thumb-white\/20::-webkit-scrollbar-thumb {
  background: linear-gradient(
    180deg,
    rgba(37, 99, 235, 0.3) 0%,
    rgba(37, 99, 235, 0.5) 50%,
    rgba(37, 99, 235, 0.3) 100%
  );
  border-radius: 3px;
  border: 1px solid rgba(37, 99, 235, 0.2);
}

.scrollbar-thumb-white\/20::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(
    180deg,
    rgba(37, 99, 235, 0.5) 0%,
    rgba(37, 99, 235, 0.7) 50%,
    rgba(37, 99, 235, 0.5) 100%
  );
  border-color: rgba(37, 99, 235, 0.4);
}

.scrollbar-hide {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.scrollbar-hide::-webkit-scrollbar {
  display: none;
}

.scrollbar-track-transparent::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.1);
  border-radius: 3px;
}

.scrollbar-track-transparent::-webkit-scrollbar-track:hover {
  background: rgba(0, 0, 0, 0.15);
}
