{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asimovuniversity",
  "main": "public/_worker.js",
  "compatibility_date": "2026-05-24",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  }
}
